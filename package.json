{
  "name": "desk-pet",
  "productName": "desk-pet",
  "version": "0.2.0",
  "private": true,
  "description": "A model-agnostic local desktop pet powered by llama.cpp.",
  "author": "desk-pet contributors",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "clean:main": "node scripts/clean-main-build.cjs",
    "build:main": "npm run clean:main && tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "test": "vitest run --root .",
    "check": "npm run typecheck && npm test && npm run build",
    "models:speech:streaming": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-streaming-model.ps1 -ModelRoot models",
    "models:speech:caption": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-caption-model.ps1 -ModelRoot models",
    "models:speech:final": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-models.ps1 -ModelRoot models",
    "models:speech": "npm run models:speech:streaming && npm run models:speech:caption && npm run models:speech:final",
    "models:tts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-tts-model.ps1 -ModelRoot models",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "llama.cpp",
    "gguf",
    "local-ai",
    "on-device-ai"
  ],
  "license": "MIT",
  "dependencies": {
    "decibri": "^5.5.0",
    "node-cpal": "^0.1.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^1.13.4",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "cn.local.deskpet",
    "productName": "desk-pet",
    "icon": "assets/app-icon.ico",
    "asar": true,
    "asarUnpack": [
      "node_modules/decibri/**/*",
      "node_modules/@decibri/**/*",
      "node_modules/node-cpal/**/*",
      "node_modules/uiohook-napi/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*",
      "node_modules/pdf-parse/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/@napi-rs/canvas/**/*",
      "node_modules/@napi-rs/canvas-win32-x64-msvc/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "download-models.ps1",
          "download-caption-model.ps1",
          "download-streaming-model.ps1",
          "download-tts-model.ps1"
        ]
      }
    ],
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "assets/app-icon.png",
      "assets/app-icon.ico",
      "assets/tray-icon.png",
      "package.json"
    ],
    "win": {
      "forceCodeSigning": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "desk-pet-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
